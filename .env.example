# Copiá este archivo a .env y ajustá los valores.
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Argentina/Buenos_Aires

# Base de datos (por defecto sqlite; descomentar para Postgres)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=lista_precios
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cotización del dólar en tiempo real
DOLAR_API_URL=https://dolarapi.com/v1/dolares/oficial
DOLAR_CACHE_MINUTOS=10

# Cuenta de Gmail por defecto para enviar los presupuestos por email.
# Si la red bloquea el puerto 587, usar 465 con EMAIL_USE_SSL=True en vez de
# EMAIL_USE_TLS (ver abajo).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contraseña de aplicación de 16 caracteres
